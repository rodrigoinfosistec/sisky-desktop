{
  "name": "sisky-desktop",
  "version": "1.0.0",
  "description": "Sisky — Soluções Inteligentes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:icons": "node scripts/build-icons.js"
  },
  "build": {
    "appId": "com.sisky.desktop",
    "productName": "Sisky",
    "icon": "assets/icon-512.png",
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon-512.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon-512.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon-512.png"
    }
  },
  "author": "Rodrigo Freitas",
  "license": "ISC",
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  }
}
